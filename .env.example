# Voice Assistant QA Platform - Environment Configuration
# Copy this file to .env and modify as needed

# App Settings
APP_NAME=Voice Assistant QA Platform
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# API Key Authentication (CHANGE IN PRODUCTION!)
API_KEY=test-api-key-change-in-production

# Adapter Selection (mock | real)
# Use mock for development/testing without API keys
STT_ADAPTER=mock
LLM_ADAPTER=mock
TTS_ADAPTER=mock

# Real STT Configuration (FasterWhisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Real LLM Configuration
# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Real TTS Configuration
# Edge TTS (free, no API key)
EDGE_TTS_VOICE=en-IN-NeerjaExpressiveNeural

# Piper TTS (local, requires model download)
PIPER_MODEL_PATH=
PIPER_SPEAKER_ID=0

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_JSON=true

# QA Thresholds
WER_THRESHOLD_CLEAN=0.10
WER_THRESHOLD_NOISY=0.25
INTENT_ACCURACY_THRESHOLD=0.90
SLOT_ACCURACY_THRESHOLD=0.85
HALLUCINATION_THRESHOLD=0.15
LATENCY_P95_THRESHOLD_MS=5000

# S3 Logging (optional)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
ENABLE_S3_LOGGING=false