{
    "alarms": [
        {
            "name": "voice-assistant-qa-p95-latency-text-chat",
            "description": "P95 latency for /text/chat exceeded 5 seconds",
            "metricName": "P95Latency",
            "namespace": "VoiceAssistantQA",
            "dimensions": [
                {"Name": "Endpoint", "Value": "/text/chat"}
            ],
            "statistic": "Maximum",
            "period": 300,
            "evaluationPeriods": 2,
            "threshold": 5000,
            "comparisonOperator": "GreaterThanThreshold",
            "treatMissingData": "notBreaching",
            "alarmActions": [
                "arn:aws:sns:us-east-1:${ACCOUNT_ID}:voice-assistant-qa-alerts"
            ],
            "okActions": [
                "arn:aws:sns:us-east-1:${ACCOUNT_ID}:voice-assistant-qa-alerts"
            ]
        },
